# Copy to .env (gitignored) and fill in. See README → "Getting started on a new machine".

# REQUIRED. Claude API key: https://console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Only if requests fail with "must include the anthropic-workspace-id header":
# Console → Settings → Workspaces (starts with wrkspc_). Otherwise leave empty.
ANTHROPIC_WORKSPACE_ID=

# Email lookup. Leave either empty to turn that source off (people without a found
# email still get a LinkedIn invite).
# Hunter.io → API (free plan: 50 credits/month).
HUNTER_API_KEY=
# Apollo.io → Settings → Integrations → API (free plan: 75 credits/month; free accounts
# only get API access if they signed up with a work/school email).
APOLLO_API_KEY=
